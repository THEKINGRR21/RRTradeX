# PostgreSQL (Neon / Supabase / Vercel Postgres). Use the POOLED url here.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Optional direct (non-pooled) url used only for migrations.
DATABASE_URL_UNPOOLED=

# First administrator, created by the seed if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Set to "true" to create demo@ / trader@ / content@rrtradex.app accounts (demo only).
SEED_DEMO_USERS=false
DEMO_PASSWORD=

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-a-random-string

# Optional: enables the LLM-backed assistant. Without it a rule-based tutor is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
